import pygame
import random

pygame.init()

WIDTH, HEIGHT = 400, 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Car Game")

clock = pygame.time.Clock()

# Colors
WHITE = (255, 255, 255)
GRAY = (50, 50, 50)
RED = (255, 0, 0)
BLUE = (0, 100, 255)

# Player car
car_width = 50
car_height = 90
car_x = WIDTH // 2 - car_width // 2
car_y = HEIGHT - 120
car_speed = 6

# Enemy car
enemy_width = 50
enemy_height = 90
enemy_x = random.randint(50, WIDTH - 100)
enemy_y = -100
enemy_speed = 5

score = 0
font = pygame.font.SysFont(None, 36)

running = True
while running:
    clock.tick(60)
    screen.fill(GRAY)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    keys = pygame.key.get_pressed()

    if keys[pygame.K_LEFT] and car_x > 0:
        car_x -= car_speed
    if keys[pygame.K_RIGHT] and car_x < WIDTH - car_width:
        car_x += car_speed

    # Move enemy
    enemy_y += enemy_speed

    if enemy_y > HEIGHT:
        enemy_y = -100
        enemy_x = random.randint(50, WIDTH - 100)
        score += 1
        enemy_speed += 0.3

    # Draw road lines
    for y in range(0, HEIGHT, 80):
        pygame.draw.rect(screen, WHITE, (WIDTH // 2 - 5, y, 10, 40))

    # Draw cars
    player = pygame.Rect(car_x, car_y, car_width, car_height)
    enemy = pygame.Rect(enemy_x, enemy_y, enemy_width, enemy_height)

    pygame.draw.rect(screen, BLUE, player)
    pygame.draw.rect(screen, RED, enemy)

    # Collision
    if player.colliderect(enemy):
        text = font.render("GAME OVER", True, WHITE)
        screen.blit(text, (110, 260))
        pygame.display.update()
        pygame.time.wait(2000)
        running = False

    # Score
    score_text = font.render("Score: " + str(score), True, WHITE)
    screen.blit(score_text, (10, 10))

    pygame.display.update()

pygame.quit()
